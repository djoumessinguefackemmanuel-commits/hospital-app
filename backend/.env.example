# Variables techniques uniquement. Aucune valeur métier ici : tout est dans le module parametrage.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hms:hms@localhost:5432/hms
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=hms-documents
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long
DATA_ENCRYPTION_KEY=change-me-32-bytes-base64
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
OUTBOX_POLL_MS=1000
# Seed uniquement : crée l'administrateur initial si les deux sont définies (ne jamais committer de vraies valeurs)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Tests d'intégration (base migrée + seed) : TEST_DATABASE_URL=postgresql://...
